{
    "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.22/MicrosoftTeams.schema.json",
    "manifestVersion": "1.22",
    "version": "1.0.0",
    "id": "f153b892-1ac6-4694-87a4-5c9adf4a296e",
    "localizationInfo": {
        "defaultLanguageTag": "en-gb",
        "additionalLanguages": []
    },
    "developer": {
        "name": "Your Organisation",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/terms"
    },
    "name": {
        "short": "Save to SharePoint",
        "full": "Save emails to SharePoint"
    },
    "description": {
        "short": "Save or move emails into a SharePoint document library.",
        "full": "Pick a SharePoint site, document library and folder, then save the selected emails there as .eml files (attachments included). Optionally remove them from your mailbox afterwards."
    },
    "icons": {
        "outline": "assets/outline.png",
        "color": "assets/color.png"
    },
    "accentColor": "#0F6CBD",
    "validDomains": [
        "https://domellis-ntt.github.io"
    ],
    "showLoadingIndicator": false,
    "isFullScreen": false,
    "defaultBlockUntilAdminAction": false,
    "authorization": {
        "permissions": {
            "resourceSpecific": [
                {
                    "name": "MailboxItem.Read.User",
                    "type": "Delegated"
                }
            ]
        }
    },
    "extensions": [
        {
            "requirements": {
                "capabilities": [
                    {
                        "name": "Mailbox",
                        "minVersion": "1.5"
                    }
                ],
                "scopes": [
                    "mail"
                ]
            },
            "runtimes": [
                {
                    "requirements": {
                        "capabilities": [
                            {
                                "name": "Mailbox",
                                "minVersion": "1.5"
                            }
                        ]
                    },
                    "id": "TaskPaneRuntime",
                    "type": "general",
                    "code": {
                        "page": "https://domellis-ntt.github.io/save-to-sharepoint/taskpane.html"
                    },
                    "lifetime": "short",
                    "actions": [
                        {
                            "id": "TaskPaneRuntimeShow",
                            "type": "openPage",
                            "pinnable": true,
                            "multiselect": true,
                            "view": "dashboard"
                        }
                    ]
                }
            ],
            "ribbons": [
                {
                    "contexts": [
                        "mailRead"
                    ],
                    "tabs": [
                        {
                            "builtInTabId": "TabDefault",
                            "groups": [
                                {
                                    "id": "saveToSharePointGroup",
                                    "label": "Save to SharePoint",
                                    "icons": [
                                        { "size": 16, "url": "https://domellis-ntt.github.io/save-to-sharepoint/assets/icon-16.png" },
                                        { "size": 32, "url": "https://domellis-ntt.github.io/save-to-sharepoint/assets/icon-32.png" },
                                        { "size": 80, "url": "https://domellis-ntt.github.io/save-to-sharepoint/assets/icon-80.png" }
                                    ],
                                    "controls": [
                                        {
                                            "id": "saveToSharePointButton",
                                            "type": "button",
                                            "label": "Save to SharePoint",
                                            "icons": [
                                                { "size": 16, "url": "https://domellis-ntt.github.io/save-to-sharepoint/assets/icon-16.png" },
                                                { "size": 32, "url": "https://domellis-ntt.github.io/save-to-sharepoint/assets/icon-32.png" },
                                                { "size": 80, "url": "https://domellis-ntt.github.io/save-to-sharepoint/assets/icon-80.png" }
                                            ],
                                            "supertip": {
                                                "title": "Save to SharePoint",
                                                "description": "Save or move the selected emails into a SharePoint document library."
                                            },
                                            "actionId": "TaskPaneRuntimeShow"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
